{
  "expo": {
    "name": "CallsVideo Provider",
    "slug": "callsvideoprovider",
    "scheme": "callsvideoprovider",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
       "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.callsvideo.provider",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f8ef7",
          "defaultChannel": "incoming_calls_v2",
          "sounds": [
            "./assets/call_ring.wav"
          ]
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#4f8ef7",
      "androidMode": "default",
      "androidCollapsedTitle": "CallsVideo"
    },
    "owner": "virtuallink777",
    "extra": {
      "eas": {
        "projectId": "ba576808-972f-4bf3-8935-0029be335bfc"
      }
    }
  }
}
